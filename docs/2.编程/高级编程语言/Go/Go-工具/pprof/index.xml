&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#4e9a06"&gt;&amp;#34;NextGC&amp;#34;&lt;/span&gt;: 25872553,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#4e9a06"&gt;&amp;#34;LastGC&amp;#34;&lt;/span&gt;: 1512984476111075800,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#4e9a06"&gt;&amp;#34;PauseTotalNs&amp;#34;&lt;/span&gt;: 29246607,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#4e9a06"&gt;&amp;#34;PauseNs&amp;#34;&lt;/span&gt;: &lt;span style="color:#ce5c00;font-weight:bold"&gt;[&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;317474,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;1159328,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;271770,
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; ...
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id="获取命令行"&gt;获取命令行&lt;a class="td-heading-self-link" href="#%e8%8e%b7%e5%8f%96%e5%91%bd%e4%bb%a4%e8%a1%8c" aria-label="Heading self-link"&gt;&lt;/a&gt;&lt;/h2&gt;
&lt;div class="highlight"&gt;&lt;pre tabindex="0" style="background-color:#f8f8f8;-moz-tab-size:4;-o-tab-size:4;tab-size:4;-webkit-text-size-adjust:none;"&gt;&lt;code class="language-bash" data-lang="bash"&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;$ curl -s http://10.39.0.102:8080/debug/pprof/cmdline
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;/usr/bin/dockerd-D
&lt;/span&gt;&lt;/span&gt;&lt;/code&gt;&lt;/pre&gt;&lt;/div&gt;&lt;h2 id="通过客户端获取"&gt;通过客户端获取&lt;a class="td-heading-self-link" href="#%e9%80%9a%e8%bf%87%e5%ae%a2%e6%88%b7%e7%ab%af%e8%8e%b7%e5%8f%96" aria-label="Heading self-link"&gt;&lt;/a&gt;&lt;/h2&gt;
