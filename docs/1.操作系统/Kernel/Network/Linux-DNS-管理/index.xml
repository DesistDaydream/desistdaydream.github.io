&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#204a87;font-weight:bold"&gt;int&lt;/span&gt; &lt;span style="color:#000"&gt;res_ninit&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;(&lt;/span&gt;&lt;span style="color:#000"&gt;res_state&lt;/span&gt; &lt;span style="color:#000"&gt;statep&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;);&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#204a87;font-weight:bold"&gt;void&lt;/span&gt; &lt;span style="color:#000"&gt;res_nclose&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;(&lt;/span&gt;&lt;span style="color:#000"&gt;res_state&lt;/span&gt; &lt;span style="color:#000"&gt;statep&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;);&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#204a87;font-weight:bold"&gt;int&lt;/span&gt; &lt;span style="color:#000"&gt;res_nquery&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;(&lt;/span&gt;&lt;span style="color:#000"&gt;res_state&lt;/span&gt; &lt;span style="color:#000"&gt;statep&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;,&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;const&lt;/span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;char&lt;/span&gt; &lt;span style="color:#ce5c00;font-weight:bold"&gt;*&lt;/span&gt;&lt;span style="color:#000"&gt;dname&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;,&lt;/span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;int&lt;/span&gt; &lt;span style="color:#000"&gt;class&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;,&lt;/span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;int&lt;/span&gt; &lt;span style="color:#000"&gt;type&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;,&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;unsigned&lt;/span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;char&lt;/span&gt; &lt;span style="color:#000"&gt;answer&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;[.&lt;/span&gt;&lt;span style="color:#000"&gt;anslen&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;],&lt;/span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;int&lt;/span&gt; &lt;span style="color:#000"&gt;anslen&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;);&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;&lt;span style="color:#204a87;font-weight:bold"&gt;int&lt;/span&gt; &lt;span style="color:#000"&gt;res_nsearch&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;(&lt;/span&gt;&lt;span style="color:#000"&gt;res_state&lt;/span&gt; &lt;span style="color:#000"&gt;statep&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;,&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;const&lt;/span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;char&lt;/span&gt; &lt;span style="color:#ce5c00;font-weight:bold"&gt;*&lt;/span&gt;&lt;span style="color:#000"&gt;dname&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;,&lt;/span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;int&lt;/span&gt; &lt;span style="color:#000"&gt;class&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;,&lt;/span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;int&lt;/span&gt; &lt;span style="color:#000"&gt;type&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;,&lt;/span&gt;
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;unsigned&lt;/span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;char&lt;/span&gt; &lt;span style="color:#000"&gt;answer&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;[.&lt;/span&gt;&lt;span style="color:#000"&gt;anslen&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;],&lt;/span&gt; &lt;span style="color:#204a87;font-weight:bold"&gt;int&lt;/span&gt; &lt;span style="color:#000"&gt;anslen&lt;/span&gt;&lt;span style="color:#000;font-weight:bold"&gt;);&lt;/span&gt;
