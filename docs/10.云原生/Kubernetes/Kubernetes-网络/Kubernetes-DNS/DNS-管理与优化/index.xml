&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;10:09:11.928600 IP 10.96.0.10.domain &amp;gt; 10.244.2.202.35582: &lt;span style="color:#0000cf;font-weight:bold"&gt;4430&lt;/span&gt; NXDomain 0/0/0 &lt;span style="color:#ce5c00;font-weight:bold"&gt;(&lt;/span&gt;32&lt;span style="color:#ce5c00;font-weight:bold"&gt;)&lt;/span&gt;
