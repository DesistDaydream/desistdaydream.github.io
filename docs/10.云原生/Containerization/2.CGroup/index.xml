&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;lrwxrwxrwx &lt;span style="color:#0000cf;font-weight:bold"&gt;1&lt;/span&gt; root root &lt;span style="color:#0000cf;font-weight:bold"&gt;16&lt;/span&gt; Jan &lt;span style="color:#0000cf;font-weight:bold"&gt;26&lt;/span&gt; 21:46 net_prio -&amp;gt; net_cls,net_prio
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;dr-xr-xr-x &lt;span style="color:#0000cf;font-weight:bold"&gt;3&lt;/span&gt; root root &lt;span style="color:#0000cf;font-weight:bold"&gt;0&lt;/span&gt; Jan &lt;span style="color:#0000cf;font-weight:bold"&gt;26&lt;/span&gt; 21:46 perf_event
&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;dr-xr-xr-x &lt;span style="color:#0000cf;font-weight:bold"&gt;5&lt;/span&gt; root root &lt;span style="color:#0000cf;font-weight:bold"&gt;0&lt;/span&gt; Jan &lt;span style="color:#0000cf;font-weight:bold"&gt;26&lt;/span&gt; 21:46 pids
