&lt;/span&gt;&lt;/span&gt;&lt;span style="display:flex;"&gt;&lt;span&gt;dr-xr-xr-x &lt;span style="color:#0000cf;font-weight:bold"&gt;5&lt;/span&gt; root root &lt;span style="color:#0000cf;font-weight:bold"&gt;0&lt;/span&gt; Jan &lt;span style="color:#0000cf;font-weight:bold"&gt;26&lt;/span&gt; 21:46 memory
